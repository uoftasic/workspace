<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>klayout_magic_pcells: register the Magic-backed PCell libraries (one per installed PDK) and the Magic menu</description>
 <version/>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>true</autorun>
 <autorun-early>false</autorun-early>
 <priority>0</priority>
 <shortcut/>
 <show-in-menu>false</show-in-menu>
 <group-name/>
 <menu-path/>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text>import os
import sys

# The package's python/ folder is on sys.path when it is installed as a Salt
# package; this covers "klayout -b -rm &lt;checkout&gt;/pymacros/klayout_magic_pcells.lym".
_py = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "python")
if _py not in sys.path:
    sys.path.insert(0, _py)

import klayout_magic_pcells
klayout_magic_pcells.register()

# The Magic menu (DRC, extraction, LVS, the layer and port checks) and the
# recipe behind the Marker Database Browser's Rerun button. The menu needs a
# main window (none under -b); KMP_MENU=0 leaves it out.
try:
    from klayout_magic_pcells import gui as _kmp_gui
    _kmp_gui.install_menu()
    _kmp_gui.register_recipe()
except Exception as _e:
    klayout_magic_pcells._log_error("klayout_magic_pcells: the Magic menu failed: %s" % _e)
</text>
</klayout-macro>
